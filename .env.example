# Environment variables for notebooklm-batch-studio
# Copy to `.env` and fill in real values. `.env` is never committed.

APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true
API_TIMEOUT_SECONDS=15

# Data folder OUTSIDE the project (input/ output/ needs_review/ state/ db/ logs/).
# A relative path is read from THIS project folder (not from where you run a command):
# projects/<name> -> projects-data/<name>, so moving both folders together needs no change.
# An absolute path also works, e.g. an external drive: /Volumes/<drive>/projects-data/<name>
DATA_DIR=../../projects-data/notebooklm-batch-studio

# NotebookLM credential home directory (isolated in ~/.config/<project>, permission 600)
NOTEBOOKLM_HOME=~/.config/notebooklm-batch-studio
# NotebookLM Google Email (Optional reference; Google passwords must NEVER be saved in .env to protect security and bypass 2FA)
# Authenticated session tokens are maintained in ~/.config/notebooklm-batch-studio/profiles/default/storage_state.json via `uv run notebooklm login`
NOTEBOOKLM_EMAIL=user@gmail.com

# Local services: always 127.0.0.1 (not localhost / 0.0.0.0)
HTTP_HOST=127.0.0.1
HTTP_PORT=8768
HTTP_ALLOWED_ORIGINS=http://127.0.0.1:8768, http://127.0.0.1:8080
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Database: empty = SQLite at <DATA_DIR>/db/app.db; PostgreSQL: postgresql+psycopg://user@127.0.0.1:5432/dbname
DATABASE_URL=

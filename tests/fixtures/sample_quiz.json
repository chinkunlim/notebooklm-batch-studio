{
  "title": "\u7d30\u80de\u819c \u6e2c\u9a57",
  "questions": [
    {
      "question": "\u6839\u64da Singer \u8207 Nicolson \u63d0\u51fa\u4e4b\u6d41\u9ad4\u9472\u5d4c\u6a21\u578b\uff08Fluid Mosaic Model\uff09\uff0c\u95dc\u65bc\u78f7\u8102\u8cea\u5728\u7d30\u80de\u819c\u4e0a\u7684\u7d50\u69cb\u7279\u5fb5\uff0c\u4e0b\u5217\u6558\u8ff0\u4f55\u8005\u6b63\u78ba\uff1f",
      "answerOptions": [
        {
          "text": "\u78f7\u8102\u8cea\u64c1\u6709\u89aa\u6c34\u7684\u8102\u80aa\u9178\u5c3e\u90e8\uff0c\u66b4\u9732\u65bc\u6c34\u6027\u74b0\u5883\u4e2d",
          "isCorrect": false,
          "rationale": "\u8102\u80aa\u9178\u93c8\u70ba\u975e\u6975\u6027\u7d50\u69cb\uff0c\u56e0\u6b64\u5177\u6709\u758f\u6c34\u6027\u800c\u975e\u89aa\u6c34\u6027\u3002"
        },
        {
          "text": "\u78f7\u8102\u8cea\u64c1\u6709\u758f\u6c34\u7684\u78f7\u9178\u9e7d\u982d\u90e8\uff0c\u96b1\u85cf\u65bc\u96d9\u5c64\u819c\u5167\u90e8",
          "isCorrect": false,
          "rationale": "\u78f7\u9178\u9e7d\u982d\u90e8\u542b\u6709\u5e36\u96fb\u8207\u6975\u6027\u57fa\u5718\uff0c\u50be\u5411\u66b4\u9732\u65bc\u7d30\u80de\u5167\u5916\u7684\u6c34\u6027\u74b0\u5883\u4e2d\u3002"
        },
        {
          "text": "\u78f7\u8102\u8cea\u64c1\u6709\u89aa\u6c34\u7684\u78f7\u9178\u9e7d\u982d\u90e8\u66b4\u9732\u65bc\u6c34\u6027\u74b0\u5883\uff0c\u4ee5\u53ca\u758f\u6c34\u7684\u8102\u80aa\u9178\u5c3e\u90e8\u96b1\u85cf\u65bc\u96d9\u5c64\u819c\u6838\u5fc3",
          "isCorrect": true,
          "rationale": "\u96d9\u89aa\u6027\u78f7\u8102\u8cea\u6703\u5728\u6c34\u6eb6\u6db2\u4e2d\u81ea\u7d44\u88dd\uff0c\u5c07\u89aa\u6c34\u982d\u90e8\u671d\u5411\u5916\u90e8\u6c34\u76f8\uff0c\u758f\u6c34\u5c3e\u90e8\u85cf\u65bc\u5167\u90e8\u6838\u5fc3\u3002"
        },
        {
          "text": "\u78f7\u8102\u8cea\u5b8c\u5168\u7531\u758f\u6c34\u6027\u7684\u7518\u6cb9\u5206\u5b50\u69cb\u6210\uff0c\u4e0d\u5177\u5099\u96d9\u91cd\u89aa\u548c\u6027",
          "isCorrect": false,
          "rationale": "\u78f7\u8102\u8cea\u5206\u5b50\u540c\u6642\u5177\u5099\u89aa\u6c34\u8207\u758f\u6c34\u90e8\u5206\uff0c\u5c6c\u65bc\u5178\u578b\u7684\u96d9\u89aa\u6027\u5206\u5b50\u3002"
        }
      ],
      "hint": "\u601d\u8003\u78f7\u8102\u8cea\u5206\u5b50\u4e2d\u89aa\u6c34\u6027\u8207\u758f\u6c34\u6027\u5340\u57df\u5728\u7d30\u80de\u819c\u96d9\u5c64\u7d50\u69cb\u4e2d\u7684\u7a7a\u9593\u6392\u5217\u65b9\u5f0f\u3002"
    },
    {
      "question": "\u81bd\u56fa\u9187\u5728\u7d30\u80de\u819c\u4e2d\u88ab\u7a31\u70ba\u300c\u96d9\u5411\u6d41\u52d5\u6027\u7de9\u885d\u5291\u300d\uff08bidirectional fluidity buffer\uff09\uff0c\u5176\u8abf\u7bc0\u6a5f\u5236\u70ba\u4f55\uff1f",
      "answerOptions": [
        {
          "text": "\u9ad8\u6eab\u6642\u4fc3\u9032\u78f7\u8102\u8cea\u5feb\u901f\u904b\u52d5\uff0c\u4f4e\u6eab\u6642\u4fc3\u9032\u78f7\u8102\u8cea\u7dca\u5bc6\u7d50\u6676",
          "isCorrect": false,
          "rationale": "\u81bd\u56fa\u9187\u7684\u4f5c\u7528\u662f\u7a69\u5b9a\u819c\u6d41\u52d5\u6027\uff0c\u800c\u975e\u64f4\u5927\u6eab\u5ea6\u8f49\u8b8a\u5e36\u4f86\u7684\u5f71\u97ff\u3002"
        },
        {
          "text": "\u9ad8\u6eab\u6642\u9650\u5236\u78f7\u8102\u8cea\u904b\u52d5\uff0c\u4f4e\u6eab\u6642\u963b\u6b62\u78f7\u8102\u8cea\u7dca\u5bc6\u7d50\u6676",
          "isCorrect": true,
          "rationale": "\u81bd\u56fa\u9187\u5728\u9ad4\u6eab\u8f03\u9ad8\u6642\u80fd\u9650\u5236\u78f7\u8102\u8cea\u904e\u5ea6\u79fb\u52d5\uff0c\u5728\u4f4e\u6eab\u6642\u5247\u963b\u7919\u8102\u8cea\u5bc6\u5408\u7d50\u6676\uff0c\u767c\u63ee\u96d9\u5411\u7de9\u885d\u4f5c\u7528\u3002"
        },
        {
          "text": "\u7121\u8ad6\u6eab\u5ea6\u9ad8\u4f4e\uff0c\u7686\u85c9\u7531\u5b8c\u5168\u7834\u58de\u78f7\u8102\u96d9\u5c64\u819c\u7d50\u69cb\u4f86\u7dad\u6301\u6d41\u52d5\u6027",
          "isCorrect": false,
          "rationale": "\u81bd\u56fa\u9187\u7dad\u6301\u7d30\u80de\u819c\u6d41\u52d5\u6027\u662f\u900f\u904e\u8abf\u7bc0\u78f7\u8102\u8cea\u6392\u5217\uff0c\u800c\u975e\u7834\u58de\u8102\u96d9\u5c64\u7d50\u69cb\u3002"
        },
        {
          "text": "\u50c5\u5728\u4f4e\u6eab\u4e0b\u767c\u63ee\u4f5c\u7528\uff0c\u9ad8\u6eab\u6642\u6703\u81ea\u52d5\u5f9e\u7d30\u80de\u819c\u4e2d\u812b\u843d",
          "isCorrect": false,
          "rationale": "\u81bd\u56fa\u9187\u5728\u6975\u7aef\u9ad8\u6eab\u8207\u4f4e\u6eab\u4e0b\u7686\u80fd\u767c\u63ee\u76f8\u61c9\u7684\u8abf\u7bc0\u529f\u80fd\u3002"
        }
      ],
      "hint": "\u8003\u616e\u6eab\u5ea6\u8f49\u8b8a\u6642\uff0c\u81bd\u56fa\u9187\u5982\u4f55\u5f71\u97ff\u78f7\u8102\u8cea\u5206\u5b50\u7684\u904b\u52d5\u8207\u6392\u5217\u5bc6\u5408\u5ea6\u3002"
    },
    {
      "question": "\u7576\u7d30\u83cc\u57f9\u990a\u74b0\u5883\u5f9e $37^\\circ\\text{C}$ \u964d\u4f4e\u81f3 $15^\\circ\\text{C}$ \u6642\uff0c\u8102\u80aa\u9178\u4e2d\u7684\u9806\u5f0f\u96d9\u9375\uff08cis-double bonds\uff09\u5c0d\u7d30\u80de\u819c\u6709\u4f55\u5f71\u97ff\uff1f",
      "answerOptions": [
        {
          "text": "\u9806\u5f0f\u96d9\u9375\u5f15\u5165\u7d50\u69cb\u5f4e\u6298\uff0c\u9632\u6b62\u8102\u8cea\u7dca\u5bc6\u5806\u7a4d\uff0c\u5f9e\u800c\u5e6b\u52a9\u7dad\u6301\u4f4e\u6eab\u4e0b\u7684\u819c\u6d41\u52d5\u6027",
          "isCorrect": true,
          "rationale": "\u4e0d\u98fd\u548c\u8102\u80aa\u9178\u7684\u9806\u5f0f\u96d9\u9375\u9020\u6210\u7684\u5f4e\u6298\u7d50\u69cb\u80fd\u963b\u6b62\u8102\u8cea\u5206\u5b50\u7dca\u5bc6\u5806\u7a4d\uff0c\u964d\u4f4e\u4f4e\u6eab\u4e0b\u7d50\u6676\u7684\u98a8\u96aa\u3002"
        },
        {
          "text": "\u9806\u5f0f\u96d9\u9375\u4f7f\u8102\u80aa\u9178\u93c8\u8b8a\u5f97\u975e\u5e38\u76f4\u7dda\uff0c\u4fc3\u9032\u98fd\u548c\u8102\u80aa\u9178\u7684\u7dca\u5bc6\u5806\u7a4d",
          "isCorrect": false,
          "rationale": "\u9806\u5f0f\u96d9\u9375\u6703\u4f7f\u8102\u80aa\u9178\u93c8\u7522\u751f\u5f4e\u6298\u800c\u975e\u8b8a\u76f4\u3002"
        },
        {
          "text": "\u9806\u5f0f\u96d9\u9375\u5728\u4f4e\u6eab\u4e0b\u6703\u81ea\u52d5\u8f49\u8b8a\u70ba\u55ae\u9375\uff0c\u4f7f\u819c\u6d41\u52d5\u6027\u6025\u5287\u4e0b\u964d",
          "isCorrect": false,
          "rationale": "\u96d9\u9375\u7684\u5316\u5b78\u7d50\u69cb\u5728\u6eab\u5ea6\u8b8a\u5316\u6642\u4e0d\u6703\u96a8\u610f\u8f49\u5316\u70ba\u55ae\u9375\u3002"
        },
        {
          "text": "\u9806\u5f0f\u96d9\u9375\u6703\u589e\u52a0\u8102\u8cea\u7d50\u6676\u7684\u7dca\u5bc6\u5ea6\uff0c\u52a0\u901f\u819c\u7684\u51dd\u56fa",
          "isCorrect": false,
          "rationale": "\u9806\u5f0f\u96d9\u9375\u6703\u963b\u7919\u7dca\u5bc6\u5806\u7a4d\uff0c\u800c\u4e0d\u662f\u4fc3\u9032\u7d50\u6676\u3002"
        }
      ],
      "hint": "\u9806\u5f0f\u96d9\u9375\u9020\u6210\u7684\u5206\u5b50\u7d50\u69cb\u5f4e\u6298\uff08kinks\uff09\u6703\u5982\u4f55\u6539\u8b8a\u8102\u8cea\u4e4b\u9593\u7684\u6392\u5217\u65b9\u5f0f\uff1f"
    },
    {
      "question": "\u95dc\u65bc\u7c21\u55ae\u64f4\u6563\uff08Simple Diffusion\uff09\u8207\u4fc3\u9032\u64f4\u6563\uff08Facilitated Diffusion\uff09\u7684\u6bd4\u8f03\uff0c\u4e0b\u5217\u4f55\u8005\u6b63\u78ba\uff1f",
      "answerOptions": [
        {
          "text": "\u7c21\u55ae\u64f4\u6563\u9700\u8981\u819c\u86cb\u767d\u4ecb\u5c0e\uff0c\u4f8b\u5982\u4ee5 GLUT1 \u904b\u8f38\u8461\u8404\u7cd6",
          "isCorrect": false,
          "rationale": "GLUT1 \u4ecb\u5c0e\u8461\u8404\u7cd6\u7684\u8de8\u819c\u79fb\u52d5\uff0c\u5c6c\u65bc\u9700\u8981\u8f09\u9ad4\u86cb\u767d\u7684\u4fc3\u9032\u64f4\u6563\u3002"
        },
        {
          "text": "\u4fc3\u9032\u64f4\u6563\u9806\u8457\u96fb\u5316\u5b78\u68af\u5ea6\u9032\u884c\u4e14\u4e0d\u6d88\u8017\u76f4\u63a5\u4ee3\u8b1d\u80fd\uff08ATP\uff09\uff0c\u4f46\u9700\u8981\u819c\u86cb\u767d\u4ecb\u5c0e",
          "isCorrect": true,
          "rationale": "\u4fc3\u9032\u64f4\u6563\u5229\u7528\u901a\u9053\u86cb\u767d\u6216\u8f09\u9ad4\u86cb\u767d\u5354\u52a9\u7279\u5b9a\u7269\u8cea\u9806\u6fc3\u5ea6\u6216\u96fb\u5316\u5b78\u68af\u5ea6\u8de8\u819c\uff0c\u7121\u9808\u6d88\u8017 ATP\u3002"
        },
        {
          "text": "\u7c21\u55ae\u64f4\u6563\u9006\u8457\u6fc3\u5ea6\u68af\u5ea6\u9032\u884c\uff0c\u56e0\u6b64\u4e0d\u9700\u8981\u6d88\u8017\u80fd\u91cf",
          "isCorrect": false,
          "rationale": "\u88ab\u52d5\u904b\u8f38\uff08\u5305\u542b\u7c21\u55ae\u64f4\u6563\u8207\u4fc3\u9032\u64f4\u6563\uff09\u7686\u662f\u9806\u8457\u6fc3\u5ea6\u68af\u5ea6\u6216\u96fb\u5316\u5b78\u68af\u5ea6\u9032\u884c\u3002"
        },
        {
          "text": "\u4fc3\u9032\u64f4\u6563\u4e0d\u9700\u8981\u4efb\u4f55\u901a\u9053\u6216\u8f09\u9ad4\u86cb\u767d\uff0c\u4e3b\u8981\u904b\u8f38 $O_2$ \u8207 $CO_2$",
          "isCorrect": false,
          "rationale": "$O_2$ \u8207 $CO_2$ \u7b49\u5c0f\u578b\u975e\u6975\u6027\u5206\u5b50\u662f\u900f\u904e\u7c21\u55ae\u64f4\u6563\u76f4\u63a5\u7a7f\u8d8a\u8102\u96d9\u5c64\uff0c\u7121\u9700\u86cb\u767d\u8cea\u5354\u52a9\u3002"

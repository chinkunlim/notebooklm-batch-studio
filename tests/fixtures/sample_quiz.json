      "hint": "\u6ce8\u610f\u96e2\u5b50\u88ab\u8f49\u904b\u7684\u65b9\u5411\uff08\u80de\u5167\u6216\u80de\u5916\uff09\u53ca\u5176\u8a08\u91cf\u6bd4\u4f8b\u95dc\u4fc2\u3002"
    },
    {
      "question": "\u70ba\u4f55\u9209\u9240\u5e6b\u6d66\uff08$\\text{Na}^+/\\text{K}^+$-ATPase\uff09\u88ab\u8996\u70ba\u4e00\u7a2e\u300c\u751f\u96fb\u6027\u5e6b\u6d66\u300d\uff08electrogenic pump\uff09\uff1f",
      "answerOptions": [
        {
          "text": "\u56e0\u70ba\u5b83\u5728\u904b\u8f49\u6642\u6703\u76f4\u63a5\u7522\u751f\u9ad8\u80fd\u91cf\u7684 ATP \u5206\u5b50",
          "isCorrect": false,
          "rationale": "\u751f\u96fb\u6027\u662f\u6307\u5e6b\u6d66\u904b\u4f5c\u904e\u7a0b\u6703\u5728\u7d30\u80de\u819c\u5169\u5074\u7522\u751f\u4e0d\u5c0d\u7a31\u96fb\u8377\u5206\u5e03\uff0c\u800c\u975e\u88fd\u9020\u80fd\u91cf\u5206\u5b50\u3002"
        },
        {
          "text": "\u56e0\u70ba\u5b83\u6bcf\u6b21\u5faa\u74b0\u6de8\u79fb\u51fa 1 \u500b\u6b63\u96fb\u8377\uff0c\u5f9e\u800c\u5728\u80de\u5167\u5efa\u7acb\u6de8\u8ca0\u96fb\u7684\u819c\u96fb\u4f4d",
          "isCorrect": true,
          "rationale": "\u6bcf\u6b21\u5faa\u74b0\u79fb\u51fa 3 \u500b\u967d\u96e2\u5b50\u4e26\u79fb\u5165 2 \u500b\u967d\u96e2\u5b50\uff0c\u5c0e\u81f4\u6de8\u96fb\u8377\u79fb\u51fa\u7d30\u80de\uff0c\u4f7f\u7d30\u80de\u819c\u5167\u5074\u7dad\u6301\u8ca0\u96fb\u4f4d\u3002"
        },
        {
          "text": "\u56e0\u70ba\u5b83\u540c\u6642\u5c07\u76f8\u7b49\u6578\u91cf\u7684\u6b63\u8ca0\u96e2\u5b50\u904b\u51fa\u7d30\u80de\uff0c\u4fdd\u6301\u96fb\u4e2d\u6027",
          "isCorrect": false,
          "rationale": "\u82e5\u79fb\u5165\u8207\u79fb\u51fa\u7684\u967d\u96e2\u5b50\u6578\u91cf\u76f8\u7b49\uff0c\u5247\u7121\u6cd5\u5efa\u7acb\u8de8\u819c\u7684\u6de8\u96fb\u8377\u5dee\u3002"
        },
        {
          "text": "\u56e0\u70ba\u5b83\u6703\u5c07\u5e36\u8ca0\u96fb\u7684\u78f7\u9178\u6839\u96e2\u5b50\u76f4\u63a5\u5e6b\u6d66\u81f3\u7d30\u80de\u5916",
          "isCorrect": false,
          "rationale": "\u9209\u9240\u5e6b\u6d66\u4e3b\u8981\u8de8\u819c\u8f49\u904b\u967d\u96e2\u5b50\uff0c\u4e26\u975e\u76f4\u63a5\u5e6b\u6d66\u78f7\u9178\u6839\u96e2\u5b50\u3002"
        }
      ],
      "hint": "\u8a08\u7b97\u6bcf\u6b21\u5faa\u74b0\u4e2d\u6de8\u79fb\u51fa\u6216\u79fb\u5165\u7d30\u80de\u7684\u6b63\u96fb\u8377\u6578\u91cf\u3002"
    },
    {
      "question": "\u5c0f\u8178\u4e0a\u76ae\u7d30\u80de\u4e2d\u7684\u9209/\u8461\u8404\u7cd6\u5171\u904b\u8f38\u86cb\u767d\uff08SGLT1\uff09\u5c6c\u65bc\u4f55\u7a2e\u8de8\u819c\u904b\u8f38\u6a5f\u5236\uff1f",
      "answerOptions": [
        {
          "text": "\u521d\u7d1a\u4e3b\u52d5\u904b\u8f38\uff08Primary Active Transport\uff09",
          "isCorrect": false,
          "rationale": "\u521d\u7d1a\u4e3b\u52d5\u904b\u8f38\u76f4\u63a5\u5229\u7528 ATP \u6c34\u89e3\u80fd\u91cf\uff0c\u800c SGLT1 \u662f\u5229\u7528\u5efa\u7acb\u597d\u7684\u96e2\u5b50\u6fc3\u5ea6\u68af\u5ea6\u3002"
        },
        {
          "text": "\u6b21\u7d1a\u4e3b\u52d5\u904b\u8f38\uff08Secondary Active Transport\uff09\u4e2d\u7684\u540c\u5411\u904b\u8f38\uff08Symport\uff09",
          "isCorrect": true,
          "rationale": "SGLT1 \u5229\u7528\u9209\u9240\u5e6b\u6d66\u5efa\u7acb\u7684 $\\text{Na}^+$ \u6fc3\u5ea6\u68af\u5ea6\uff0c\u5c07 $\\text{Na}^+$ \u8207\u8461\u8404\u7cd6\u540c\u6642\u671d\u540c\u4e00\u65b9\u5411\u904b\u5165\u7d30\u80de\u3002"
        },
        {
          "text": "\u7c21\u55ae\u64f4\u6563\uff08Simple Diffusion\uff09",
          "isCorrect": false,
          "rationale": "\u8461\u8404\u7cd6\u5c6c\u65bc\u6975\u6027\u5927\u5206\u5b50\uff0c\u7121\u6cd5\u76f4\u63a5\u7c21\u55ae\u64f4\u6563\u7a7f\u8d8a\u8102\u96d9\u5c64\u3002"
        },
        {
          "text": "\u4fc3\u9032\u64f4\u6563\uff08Facilitated Diffusion\uff09",
          "isCorrect": false,
          "rationale": "\u4fc3\u9032\u64f4\u6563\u50c5\u80fd\u9806\u68af\u5ea6\u904b\u8f38\uff0c\u800c SGLT1 \u80fd\u9a45\u52d5\u8461\u8404\u7cd6\u9032\u884c\u9006\u6fc3\u5ea6\u68af\u5ea6\u7684\u7d2f\u7a4d\u3002"
        }
      ],
      "hint": "\u8a72\u904b\u8f38\u65b9\u5f0f\u5229\u7528\u5df2\u7d93\u5efa\u7acb\u597d\u7684\u96e2\u5b50\u68af\u5ea6\uff08\u5982 $\\text{Na}^+$ \u68af\u5ea6\uff09\u4f86\u9a45\u52d5\u53e6\u4e00\u7269\u8cea\u9006\u68af\u5ea6\u8de8\u819c\u3002"
    },
    {
      "question": "\u7576\u7d30\u80de\u5167\u7684\u4f4e\u5bc6\u5ea6\u8102\u86cb\u767d\uff08LDL\uff09\u53d7\u9ad4\u767c\u751f\u57fa\u56e0\u7f3a\u9677\u6642\uff0c\u6700\u53ef\u80fd\u5f15\u767c\u4e0b\u5217\u54ea\u4e00\u7a2e\u81e8\u5e8a\u75c5\u75c7\uff1f",
      "answerOptions": [
        {
          "text": "\u9ad8\u81bd\u56fa\u9187\u8840\u75c7\uff08Hypercholesterolemia\uff09",
          "isCorrect": true,
          "rationale": "LDL \u53d7\u9ad4\u7f3a\u9677\u6703\u5c0e\u81f4\u7d30\u80de\u7121\u6cd5\u900f\u904e\u53d7\u9ad4\u4ecb\u5c0e\u7684\u80de\u541e\u4f5c\u7528\u5438\u6536\u8840\u6db2\u4e2d\u7684 LDL\uff0c\u9032\u800c\u5f15\u767c\u8840\u6db2\u81bd\u56fa\u9187\u904e\u9ad8\u3002"
        },
        {
          "text": "\u4f4e\u8840\u7cd6\u75c7\uff08Hypoglycemia\uff09",
          "isCorrect": false,
          "rationale": "LDL \u53d7\u9ad4\u7f3a\u9677\u5f71\u97ff\u7684\u662f\u8102\u8cea\u4ee3\u8b1d\u800c\u975e\u8461\u8404\u7cd6\u4ee3\u8b1d\u3002"
        },
        {
          "text": "\u56ca\u816b\u6027\u7e96\u7dad\u5316\uff08Cystic Fibrosis\uff09",
          "isCorrect": false,
          "rationale": "\u56ca\u816b\u6027\u7e96\u7dad\u5316\u8207\u6c2f\u96e2\u5b50\u901a\u9053\u7f3a\u9677\u76f8\u95dc\uff0c\u800c\u975e LDL \u53d7\u9ad4\u3002"
        },
        {
          "text": "\u7cd6\u5c3f\u75c5\uff08Diabetes Mellitus\uff09",
          "isCorrect": false,
          "rationale": "\u7cd6\u5c3f\u75c5\u8207\u80f0\u5cf6\u7d20\u4f5c\u7528\u6216\u5206\u6ccc\u76f8\u95dc\uff0c\u975e\u7531 LDL \u53d7\u9ad4\u7f3a\u9677\u76f4\u63a5\u5f15\u8d77\u3002"
        }
      ],
      "hint": "\u53d7\u9ad4\u4ecb\u5c0e\u7684\u80de\u541e\u4f5c\u7528\u82e5\u7121\u6cd5\u6b63\u5e38\u651d\u53d6\u8840\u6db2\u4e2d\u7684 LDL \u81bd\u56fa\u9187\uff0c\u8840\u6db2\u4e2d\u7684\u81bd\u56fa\u9187\u6fc3\u5ea6\u6703\u5982\u4f55\u8b8a\u5316\uff1f"
    },
    {
      "question": "\u7db2\u683c\u86cb\u767d\u8986\u84cb\u51f9\u9677\uff08Clathrin-coated pits\uff09\u4e3b\u8981\u53c3\u8207\u4e0b\u5217\u54ea\u4e00\u7a2e\u8de8\u819c\u904b\u8f38\u904e\u7a0b\uff1f",
      "answerOptions": [
        {
          "text": "\u541e\u566c\u4f5c\u7528\uff08Phagocytosis\uff09",
          "isCorrect": false,
          "rationale": "\u541e\u566c\u4f5c\u7528\u4e3b\u8981\u662f\u7d30\u80de\u5ef6\u4f38\u507d\u8db3\u5305\u570d\u5927\u578b\u9846\u7c92\uff0c\u901a\u5e38\u4e0d\u4f9d\u8cf4\u7db2\u683c\u86cb\u767d\u8986\u84cb\u51f9\u9677\u5f62\u6210\u56ca\u6ce1\u3002"
        },
        {
          "text": "\u80de\u98f2\u4f5c\u7528\uff08Pinocytosis\uff09",
          "isCorrect": false,
          "rationale": "\u80de\u98f2\u4f5c\u7528\u70ba\u975e\u5c08\u4e00\u6027\u5730\u651d\u53d6\u7d30\u80de\u5916\u6db2\u9ad4\u6ef4\u3002"
        },
        {
          "text": "\u53d7\u9ad4\u4ecb\u5c0e\u7684\u80de\u541e\u4f5c\u7528\uff08Receptor-mediated Endocytosis\uff09",
          "isCorrect": true,
          "rationale": "\u53d7\u9ad4\u4ecb\u5c0e\u7684\u80de\u541e\u4f5c\u7528\u4f9d\u8cf4\u7db2\u683c\u86cb\u767d\u8986\u84cb\u51f9\u9677\uff08clathrin-coated pits\uff09\u4f86\u5f62\u6210\u5167\u541e\u56ca\u6ce1\uff0c\u5c07\u7d50\u5408\u53d7\u9ad4\u7684\u7279\u5b9a\u914d\u9ad4\u651d\u5165\u7d30\u80de\u3002"
        },
        {
          "text": "\u80de\u5410\u4f5c\u7528\uff08Exocytosis\uff09",
          "isCorrect": false,
          "rationale": "\u80de\u5410\u4f5c\u7528\u662f\u56ca\u6ce1\u8207\u7d30\u80de\u819c\u878d\u5408\u5c07\u7269\u8cea\u6392\u51fa\u7684\u904e\u7a0b\uff0c\u800c\u975e\u5167\u541e\u3002"
        }
      ],
      "hint": "\u9019\u662f\u7d30\u80de\u85c9\u7531\u5c08\u4e00\u6027\u53d7\u9ad4\u7d50\u5408\u5916\u4f86\u5206\u5b50\u5f8c\uff0c\u5229\u7528\u86cb\u767d\u8cea\u8863\u98fe\u51f9\u9677\u5305\u88f9\u5f62\u6210\u5167\u541e\u56ca\u6ce1\u7684\u904e\u7a0b\u3002"
    },
    {
      "question": "\u4e0b\u5217\u4f55\u8005\u5c6c\u65bc\u80de\u5410\u4f5c\u7528\uff08Exocytosis\uff09\u5728\u4eba\u9ad4\u751f\u7406\u6a5f\u80fd\u4e0a\u7684\u5be6\u969b\u61c9\u7528\uff1f",
      "answerOptions": [
        {
          "text": "\u5de8\u566c\u7d30\u80de\u541e\u566c\u5165\u4fb5\u7684\u7d30\u83cc\u9846\u7c92",
          "isCorrect": false,
          "rationale": "\u5de8\u566c\u7d30\u80de\u541e\u566c\u7d30\u83cc\u662f\u5c07\u5916\u7269\u651d\u5165\u7d30\u80de\u5167\u7684\u80de\u541e\u4f5c\u7528\uff08\u541e\u566c\u4f5c\u7528\uff09\u3002"
        },
        {
          "text": "\u795e\u7d93\u7a81\u89f8\u8655\u91cb\u653e\u795e\u7d93\u50b3\u5c0e\u7269\u8cea\u8207\u80f0\u81df\u4e59\u7d30\u80de\u5206\u6ccc\u80f0\u5cf6\u7d20",
          "isCorrect": true,
          "rationale": "\u795e\u7d93\u50b3\u5c0e\u7269\u8cea\u91cb\u653e\u8207\u80f0\u5cf6\u7d20\u5206\u6ccc\u7686\u662f\u5206\u6ccc\u6027\u56ca\u6ce1\u8207\u7d30\u80de\u819c\u878d\u5408\u5f8c\u5c07\u7269\u8cea\u91cb\u653e\u81f3\u80de\u5916\u7684\u80de\u5410\u4f5c\u7528\u3002"
        },
        {
          "text": "\u6c34\u5206\u5b50\u7d93\u7531\u6c34\u901a\u9053\u86cb\u767d\uff08Aquaporins\uff09\u5feb\u901f\u8de8\u819c",
          "isCorrect": false,
          "rationale": "\u6c34\u5206\u5b50\u7d93\u6c34\u901a\u9053\u86cb\u767d\u79fb\u52d5\u5c6c\u65bc\u88ab\u52d5\u904b\u8f38\u4e2d\u7684\u6ef2\u900f\u4f5c\u7528\u3002"
        },
        {
          "text": "\u7d30\u80de\u7d93\u7531\u53d7\u9ad4\u7d50\u5408\u4e26\u5438\u6536\u8840\u6db2\u4e2d\u7684 LDL \u81bd\u56fa\u9187",
          "isCorrect": false,
          "rationale": "\u5438\u6536 LDL \u81bd\u56fa\u9187\u662f\u7d30\u80de\u5c07\u5916\u90e8\u7269\u8cea\u651d\u5165\u80de\u5167\u7684\u53d7\u9ad4\u4ecb\u5c0e\u80de\u541e\u4f5c\u7528\u3002"
        }
      ],
      "hint": "\u56de\u60f3\u5206\u6ccc\u6027\u56ca\u6ce1\u8207\u7d30\u80de\u819c\u878d\u5408\u5f8c\u5c07\u5167\u90e8\u7269\u8cea\u91cb\u653e\u5230\u7d30\u80de\u5916\u7684\u904e\u7a0b\u3002"
    }
  ]
